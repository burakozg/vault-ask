# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# All secrets are env-only — they must never appear in config.yaml.

# --- Required to index or query anything ------------------------------------
VAULTASK_VAULT__COUCHDB_URL=http://couchdb.local:5984
VAULTASK_VAULT_COUCHDB_PASSWORD=

# Needed once models.generation / models.rerank point at an openrouter/ model
# (the shipped config.yaml default for both).
VAULTASK_OPENROUTER_API_KEY=

# --- Admin console (optional) ------------------------------------------------
# Gates GET/PUT/DELETE /admin/config (the page at /admin is served without
# it — only the data behind it is protected). Unset means the console is
# closed, never open to everyone: pick a long random value, e.g.
# `openssl rand -hex 32`.
VAULTASK_ADMIN_API_KEY=

# --- Search providers (optional) --------------------------------------------
# The web fallback works with no key at all: `web.provider: duckduckgo` is the
# default and needs no account. Set one of these to make that provider
# selectable in the admin console — it stays greyed out until the key exists.
# Keys are environment-only by design: never in config.yaml, never in
# overrides.json, never settable from a browser form.
#   Tavily  https://tavily.com   cleaned extracts built for RAG, ~1000/mo free
#   Brave   https://brave.com/search/api   independent index, ~2000/mo free
VAULTASK_TAVILY_API_KEY=
VAULTASK_BRAVE_API_KEY=

# Path to the non-secret config file. The container sets this to
# /config/config.yaml; locally it defaults to ./config.yaml.
# VAULTASK_CONFIG_FILE=/config/config.yaml

# Path to the admin console's overrides file. The container sets this to
# /data/overrides.json (the bind-mounted, writable directory); locally it
# defaults to the same path, which usually does not exist on a dev machine.
# VAULTASK_OVERRIDES_FILE=/data/overrides.json

# Any config.yaml value can be overridden with VAULTASK_<SECTION>__<KEY>:
# VAULTASK_RETRIEVAL__FINAL_TOP_K=10
# VAULTASK_LOGGING__LEVEL=DEBUG
