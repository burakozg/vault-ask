# Copy to .deploy.env and fill in your real values. .deploy.env is git-ignored —
# never commit it. ./deploy auto-sources it. See homelab/README.md for the
# contract these names follow.

# ssh destination for the NAS host itself.
NAS_SSH=deploy@nas.local
NAS_SSH_PORT=22

# This container's own address on the qnet macvlan — where curl / API clients
# reach it. Unlike clippings-topics, this one listens.
APP_LAN_IP=10.0.0.2

# Open WebUI's own qnet address — where a browser reaches the UI. Separate
# from APP_LAN_IP: the two containers talk to each other over a private
# bridge network, never through either qnet address (docker-compose.nas.yml).
WEBUI_LAN_IP=10.0.0.4

# The vault's own CouchDB — the same one Self-hosted LiveSync replicates
# against. Required. Same address the other four apps already point at
# (see their own .deploy.env, or clippings-topics/.env's VAULT_COUCHDB_URL).
VAULT_LAN_IP=10.0.0.2

# A LAN machine running Ollama (see OLLAMA-SETUP.md) — not necessarily the
# NAS, and not this container. Required.
EMBEDDING_HOST=10.0.0.3

# Optional.
# NAS_APP_DIR=/share/Container/vault-ask
# NAS_DOCKER_BIN=/share/CACHEDEV1_DATA/.qpkg/container-station/bin/docker
# NAS_PLATFORM=linux/amd64
